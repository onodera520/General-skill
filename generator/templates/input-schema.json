{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generator normalized input v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "screenplay": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "locator",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "character",
              "scene",
              "prop",
              "other"
            ]
          },
          "entity_hint": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "availability": {
            "enum": [
              "readable",
              "unavailable",
              "uninspected",
              "text_only"
            ]
          },
          "views": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "view_id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "region": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "view_id",
                "label",
                "region"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "user_description": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "asset_id",
          "reference",
          "kind",
          "entity_hint",
          "version",
          "availability",
          "views",
          "user_description"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "text_only"
                }
              },
              "required": [
                "availability"
              ]
            },
            "then": {
              "properties": {
                "user_description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    },
    "creative_brief": {
      "type": "object",
      "properties": {
        "style": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "aspect_ratio": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "total_duration_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "shot_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "description_language": {
          "type": "string",
          "minLength": 1
        },
        "prompt_languages": {
          "type": "array",
          "items": {
            "enum": [
              "zh-CN",
              "en"
            ]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "default": [
            "zh-CN",
            "en"
          ]
        }
      },
      "required": [
        "style",
        "aspect_ratio",
        "total_duration_seconds",
        "shot_count",
        "description_language",
        "prompt_languages"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "constraint_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "scope_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "constraint_id",
          "text",
          "scope_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "resume_context": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "screenplay",
    "assets",
    "creative_brief",
    "constraints",
    "resume_context"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "locator",
        "text"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "character",
            "scene",
            "prop",
            "other"
          ]
        },
        "entity_hint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "availability": {
          "enum": [
            "readable",
            "unavailable",
            "uninspected",
            "text_only"
          ]
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "view_id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "view_id",
              "label",
              "region"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "user_description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "asset_id",
        "reference",
        "kind",
        "entity_hint",
        "version",
        "availability",
        "views",
        "user_description"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "text_only"
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "user_description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "assumption": {
      "type": "object",
      "properties": {
        "assumption_id": {
          "type": "string",
          "minLength": 1
        },
        "scope_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "assumption_id",
        "scope_ids",
        "decision",
        "basis",
        "impact"
      ],
      "additionalProperties": false
    }
  }
}
