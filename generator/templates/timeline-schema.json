{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generator frozen timeline v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "timeline_version": {
      "type": "integer",
      "minimum": 1
    },
    "locked": {
      "const": true
    },
    "total_duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "beat_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "kind": {
            "enum": [
              "original",
              "supplement"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "estimate_basis": {
            "type": "string",
            "minLength": 1
          },
          "overlays_block_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "overlaps_with": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "block_id",
          "beat_ids",
          "start",
          "end",
          "kind",
          "description",
          "estimate_basis",
          "overlays_block_id",
          "depends_on",
          "overlaps_with"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "audio_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "audio_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "dialogue",
              "narration",
              "sfx"
            ]
          },
          "speaker": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "delivery": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "source_id",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "beat_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "estimate_basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "audio_id",
          "kind",
          "speaker",
          "language",
          "text",
          "start",
          "end",
          "delivery",
          "source",
          "beat_ids",
          "estimate_basis"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "dialogue",
                    "narration"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "source": {
                  "type": "object",
                  "properties": {
                    "source_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "source_id",
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                },
                "speaker": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    },
    "indivisible_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "beat_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "group_id",
          "start",
          "end",
          "beat_ids",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "timeline_version",
    "locked",
    "total_duration",
    "blocks",
    "audio_events",
    "indivisible_groups"
  ],
  "additionalProperties": false
}
