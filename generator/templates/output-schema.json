            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "initial_state": {
          "type": "string",
          "minLength": 1
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "entity_id",
        "kind",
        "name",
        "aliases",
        "version",
        "asset_ids",
        "fixed_traits",
        "initial_state",
        "unresolved"
      ],
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "coordinate_system": {
          "type": "string",
          "minLength": 1
        },
        "layout_basis": {
          "type": "string",
          "minLength": 1
        },
        "landmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "landmark_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "world_position": {
                "type": "string",
                "minLength": 1
              },
              "appearance": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "knowledge_status": {
                    "enum": [
                      "observed",
                      "user_provided",
                      "script",
                      "assumed",
                      "unknown"
                    ]
                  },
                  "evidence_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "description",
                  "knowledge_status",
                  "evidence_ref"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "landmark_id",
              "name",
              "world_position",
              "appearance",
              "basis"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "entrances": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "light_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "scene_id",
        "entity_id",
        "version",
        "coordinate_system",
        "layout_basis",
        "landmarks",
        "entrances",
        "light_sources",
        "unresolved"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "number",
          "minimum": 0
        },
        "entity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "script",
            "execution_detail",
            "transition"
          ]
        },
        "source_beat_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "event_id",
        "shot_id",
        "time",
        "entity_ids",
        "field",
        "before",
        "after",
        "basis",
        "source_beat_ids"
      ],
      "additionalProperties": false
    },
    "textoutput": {
      "type": "object",
      "properties": {
        "shot_id": {
          "type": "string",
